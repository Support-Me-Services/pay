APP_NAME="SupportMe (lokalnie)"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=pl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pl_PL

# localhost nie jest domeną produkcyjną -> tenant dobierany z config/tenants.php
# (wpis 'localhost' => church/nfc_shop1). TENANT to fallback dla CLI (artisan).
TENANT=please-support-me.com

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=nfc_shop1
DB_USERNAME=nfc_pay
DB_PASSWORD=secret
DB_GATEWAY_DATABASE=nfc_pay

# Lokalnie bez realnej bramki: „Kupuję i płacę" -> ekran podziękowania (koszyk/sklep).
PAYMENT_PROVIDER=mock
PAYMENT_BYPASS=true

# Klucz API sklepu do wewnetrznej bramki (tabela shops.api_key w nfc_pay) — bez
# niego flow "Wesprzyj" (parafia/produkt) konczy sie 401 zamiast pokazac mock PayU.
# Shop z tym kluczem tworzy entrypoint.sh (idempotentnie, po migracji Gateway).
GATEWAY_API_KEY_CHURCH=a80f39aad1f3402fd24d6eb5dad7bb9ca89b40288115b4288feaeccef884a138

# "php artisan serve" domyslnie obsluguje jedno polaczenie naraz — flow "Wesprzyj"
# robi self-call sklepu do wlasnego API bramki i blokowalby sie na 10s (timeout
# GatewayClient). Wiecej workerow (wymaga --no-reload w entrypoint.sh + pcntl
# w obrazie) pozwala serwerowi obsluzyc zagniezdzone zadanie rownolegle.
PHP_CLI_SERVER_WORKERS=4

# Pliki zamiast bazy -> bez potrzeby dodatkowych tabel na sesje/cache/kolejki.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=stack
