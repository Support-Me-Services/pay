APP_NAME="SupportMe (lokalnie)"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=pl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pl_PL

# localhost nie jest domeną produkcyjną -> tenant dobierany z config/tenants.php
# (wpis 'localhost' => church/nfc_shop1). TENANT to fallback dla CLI (artisan).
TENANT=please-support-me.com

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=nfc_shop1
DB_USERNAME=nfc_pay
DB_PASSWORD=secret
DB_GATEWAY_DATABASE=nfc_pay

# Lokalnie bez realnej bramki: „Kupuję i płacę" -> ekran podziękowania (koszyk/sklep).
PAYMENT_PROVIDER=mock
PAYMENT_BYPASS=true

# Klucz API sklepu do wewnetrznej bramki (tabela shops.api_key w nfc_pay) — bez
# niego flow "Wesprzyj" (parafia/produkt) konczy sie 401 zamiast pokazac mock PayU.
# Shop z tym kluczem tworzy entrypoint.sh (idempotentnie, po migracji Gateway).
GATEWAY_API_KEY_CHURCH=a80f39aad1f3402fd24d6eb5dad7bb9ca89b40288115b4288feaeccef884a138

# "php artisan serve" domyslnie obsluguje jedno polaczenie naraz — flow "Wesprzyj"
# robi self-call sklepu do wlasnego API bramki i blokowalby sie na 10s (timeout
# GatewayClient). Wiecej workerow (wymaga --no-reload w entrypoint.sh + pcntl
# w obrazie) pozwala serwerowi obsluzyc zagniezdzone zadanie rownolegle.
PHP_CLI_SERVER_WORKERS=4

# Pliki zamiast bazy -> bez potrzeby dodatkowych tabel na sesje/cache/kolejki.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=stack

# Faza 5: fallback dla wywolan HTTP-do-siebie bez powiazanego Request (np.
# z workera gRPC RoadRunner) — bez tego GatewayClient spada na domyslny
# adres produkcyjny w config/shop.php i wisi/timeoutuje lokalnie.
GATEWAY_URL=http://localhost:8000

# Faza 6 — logowanie panelu wylacznie przez Keycloak. base_url/realm sa
# stale lokalnie; sekrety klientow poufnych (laravel-panel-gateway,
# laravel-panel-storefront) NIE moga tu byc realna wartoscia (partial-export
# Keycloaka maskuje sekrety, wiec swiezy import i tak wygenerowalby inny) —
# po kazdym swiezym imporcie realmu ustaw je w .env (NIE .env.docker) na to,
# co faktycznie ma klient w Keycloaku (konsola admina -> Clients -> Credentials),
# ten sam wzorzec co odtwarzanie testowego uzytkownika po swiezym imporcie.
KEYCLOAK_BASE_URL=http://localhost:8180
# Adres widoczny z przegladarki (localhost:8180) NIE jest tym, pod ktorym
# TEN kontener dobija sie do Keycloaka (wywolania serwer-serwer: token,
# userinfo) — ten sam problem co jwk-set-uri vs issuer w api-gateway
# (Faza 3). Wartosc zalezy od tego, JAK odpalasz stack:
#   - Kubernetes (k8s/, jeden namespace)      -> http://keycloak:8080
#   - docker-compose (docker/ + ecosystem/,
#     DWA OSOBNE projekty/sieci compose)      -> http://host.docker.internal:8180
# Domyslnie k8s (aktualny stan tej sesji) — nadpisz w .env jesli inaczej.
KEYCLOAK_INTERNAL_BASE_URL=http://keycloak:8080
KEYCLOAK_REALM=pay
KEYCLOAK_CLIENT_SECRET_GATEWAY=ustaw-w-.env-po-swiezym-imporcie-realmu
KEYCLOAK_CLIENT_SECRET_STOREFRONT=ustaw-w-.env-po-swiezym-imporcie-realmu
