APP_NAME="SupportMe (lokalnie)"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=pl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pl_PL

# localhost nie jest domeną produkcyjną -> tenant dobierany z config/tenants.php
# (wpis 'localhost' => church/nfc_shop1). TENANT to fallback dla CLI (artisan).
TENANT=please-support-me.com

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=nfc_shop1
DB_USERNAME=nfc_pay
DB_PASSWORD=secret
DB_GATEWAY_DATABASE=nfc_pay

# Lokalnie bez realnej bramki: „Kupuję i płacę" -> ekran podziękowania.
PAYMENT_PROVIDER=mock
PAYMENT_BYPASS=true

# Pliki zamiast bazy -> bez potrzeby dodatkowych tabel na sesje/cache/kolejki.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=stack
