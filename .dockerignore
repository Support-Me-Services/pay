# docker/Dockerfile.ci (Faza 7) robi COPY . . z korzenia repo — bez tego
# kontekst budowania ciągnąłby .git/, node_modules/, vendor/ i .env
# (prawdziwe sekrety lokalne, w .gitignore, ale na wszelki wypadek jawnie
# tu też wykluczone).
.git
node_modules
vendor
public/build
storage/framework/cache
storage/framework/sessions
storage/framework/views
storage/logs
.env
.env.*
!.env.example
!.env.docker
# NIE services/ — services/core-svc i services/api-gateway budują się z
# TEGO SAMEGO korzenia repo (patrz .github/workflows/ephemeral-env.yml),
# .dockerignore obowiązuje globalnie dla każdego builda z tym kontekstem
# (wykluczenie tu złamałoby COPY services/core-svc w ich Dockerfile'ach —
# dokładnie to się stało przy pierwszym przebiegu CI Fazy 7).
k8s
ecosystem
