    <changeSet author="Marcin Lula" id="20260707-shop-1">
        <comment>Wariant sklepowy PayU: shop_items.price (grosze) + description (oferta)</comment>
        <addColumn tableName="shop_items">
            <column name="price" type="INTEGER"/>
            <column name="description" type="TEXT"/>
        </addColumn>
    </changeSet>
    <changeSet author="Marcin Lula" id="20260707-shop-2">
        <comment>Backfill: brakująca cena = dotychczasowe min_amount</comment>
        <sql>UPDATE shop_items SET price = min_amount WHERE price IS NULL</sql>
    </changeSet>
    <changeSet author="Marcin Lula" id="20260707-shop-3">
        <comment>Sklepy per-konto: users.handle = slug sklepu pod /people/{handle}</comment>
        <addColumn tableName="users">
            <column name="handle" type="VARCHAR(255)"/>
        </addColumn>
    </changeSet>
    <changeSet author="Marcin Lula" id="20260707-shop-4">
        <createIndex indexName="users_handle_unique" tableName="users" unique="true">
            <column name="handle"/>
        </createIndex>
    </changeSet>
    <changeSet author="Marcin Lula" id="20260707-shop-5">
        <comment>Backfill handle: admin@local lub pierwsze konto -> lula-marcin; reszta -> user-{id}</comment>
        <sql>UPDATE users SET name = 'Marcin Lula', handle = 'lula-marcin' WHERE email = 'admin@local'</sql>
        <sql>UPDATE users SET handle = 'lula-marcin' WHERE handle IS NULL AND (SELECT c FROM (SELECT COUNT(*) c FROM users u WHERE u.handle = 'lula-marcin') z) = 0 AND id = (SELECT m FROM (SELECT MIN(id) m FROM users) y)</sql>
        <sql>UPDATE users SET handle = CONCAT('user-', id) WHERE handle IS NULL</sql>
    </changeSet>
    <changeSet author="Marcin Lula" id="20260707-shop-6">
        <comment>Właściciel produktu (sklepy per-konto)</comment>
        <addColumn tableName="shop_items">
            <column name="user_id" type="BIGINT"/>
        </addColumn>
    </changeSet>
    <changeSet author="Marcin Lula" id="20260707-shop-7">
        <createIndex indexName="shop_items_user_id_index" tableName="shop_items">
            <column name="user_id"/>
        </createIndex>
    </changeSet>
    <changeSet author="Marcin Lula" id="20260707-shop-8">
        <comment>Backfill: istniejące produkty -> właściciel lula-marcin</comment>
        <sql>UPDATE shop_items SET user_id = (SELECT id FROM users WHERE handle = 'lula-marcin' LIMIT 1) WHERE user_id IS NULL</sql>
    </changeSet>
    <changeSet author="Marcin Lula" id="20260707-shop-9">
        <comment>Slug unikalny per-konto zamiast globalnie: usuń stary globalny unique</comment>
        <dropIndex indexName="shop_items_slug_unique" tableName="shop_items"/>
    </changeSet>
    <changeSet author="Marcin Lula" id="20260707-shop-10">
        <createIndex indexName="shop_items_user_id_slug_unique" tableName="shop_items" unique="true">
            <column name="user_id"/>
            <column name="slug"/>
        </createIndex>
    </changeSet>
    <changeSet author="Marcin Lula" id="20260707-shop-11">
        <comment>Podstrona „Wspieramy" (/beneficiaries) — węzły edytowalne w panelu</comment>
        <createTable tableName="beneficiary_nodes">
            <column autoIncrement="true" name="id" type="BIGINT">
