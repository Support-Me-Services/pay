[Unit]
# Proces SSR Inertia (Node) dla SupportME — renderuje strony React po stronie
# serwera i nasłuchuje na 127.0.0.1:13714 (config/inertia.php -> ssr.url).
# Instalacja:
#   sudo cp /var/www/support-me/bin/pay-ssr.service /etc/systemd/system/pay-ssr.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now pay-ssr
# Restart po buildzie robi bin/deploy.sh (systemctl restart pay-ssr).
Description=SupportME Inertia SSR (Node)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/support-me
# Uruchamia bundle SSR bezpośrednio Node'em (port 13714 zaszyty w ssr.js /
# config/inertia.php). UWAGA: ta wersja inertia-laravel NIE ma komendy
# `artisan inertia:start-ssr` — użyj node, nie artisana.
ExecStart=/usr/bin/node bootstrap/ssr/ssr.js
Restart=always
RestartSec=2
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
