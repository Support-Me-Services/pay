# Skopiuj do .env (NIE commitować .env) — używane przez `docker compose` do
# podstawienia zmiennych w docker-compose.yml. UWAGA: to NIE zasila
# automatycznie samej aplikacji Spring Boot (Gradle/JVM nie czyta plików
# .env) — te same wartości muszą być wystawione w środowisku procesu, który
# odpala `./gradlew :app:bootRun` (np. `export $(cat .env | xargs)` w bashu,
# albo ustawione ręcznie przed komendą).

DB_USERNAME=nfc_pay
DB_PASSWORD=secret
DB_PORT=5432
DB_GATEWAY_DATABASE=nfc_pay

# Publiczny adres bramki — PayU woła TEN adres jako webhook (niezależnie od
# notify_url pojedynczej transakcji, patrz PaymentController.toOrderRequest).
# Domyślnie localhost:8080 (dev); na produkcji MUSI być
# https://pay.please-support-me.com, inaczej realne płatności PayU nigdy nie
# dotrą do webhooka bramki.
GATEWAY_PUBLIC_BASE_URL=http://localhost:8080

# mock | payu — mock nie wymaga żadnych z poniższych danych PayU.
PAYMENT_PROVIDER=mock

PAYU_ENV=sandbox
PAYU_MERCHANT_ID=
PAYU_POS_ID=
PAYU_CLIENT_ID=
PAYU_CLIENT_SECRET=
PAYU_SECOND_KEY=

# WYŁĄCZNIE dla /activation-status (monitoring aktywacji nowego POS-a PayU) —
# zawsze bije w PRODUKCYJNE secure.payu.com, niezależnie od PAYU_ENV powyżej.
PAYU_NEWPOS_CLIENT_ID=
PAYU_NEWPOS_CLIENT_SECRET=
ACTIVATION_CHECK_TOKEN=

# Klucz API sklepu-klienta (church) w bramce Gateway — musi być zgodny
# z api_key realnego wiersza w tabeli `shops` (baza nfc_pay), inaczej
# Storefront nie połączy się z Gateway (401 przy próbie zakupu).
GATEWAY_API_KEY_CHURCH=
