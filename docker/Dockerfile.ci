# Wariant docker/Dockerfile do budowania w CI (Faza 7 — efemeryczne
# środowisko na GCP). Różnica względem docker/Dockerfile (lokalny, dev):
# TAM kod wchodzi przez hostPath (dysk Windows widoczny w Docker Desktop),
# co fizycznie nie istnieje na GKE — TU kod/vendor/zbudowany frontend są
# zapieczone w obrazie. docker/entrypoint.sh zostaje bez zmian: jest już
# idempotentny (composer install tylko gdy vendor/ brakuje), więc po
# prostu no-opuje kroki, które ten obraz ma już gotowe.
#
# Kontekst budowania MUSI być korzeniem repo (tak jak docker/Dockerfile).

FROM composer:2 AS composer-deps
WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-interaction --prefer-dist --no-scripts --no-progress

FROM node:22-slim AS frontend
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# Tylko build klienta (vite build) — lokalny Docker Desktop k8s też nie
# uruchamia SSR (osobny proces Node, wyłącznie na serwerze prod/stage,
# patrz bin/deploy.sh); efemeryczne środowisko testowe naśladuje to samo.
RUN npm run build:client

FROM php:8.2-cli
RUN apt-get update && apt-get install -y --no-install-recommends \
        libonig-dev libzip-dev unzip git ca-certificates protobuf-compiler \
 && docker-php-ext-install pdo_mysql mbstring zip pcntl sockets \
 && docker-php-ext-enable opcache \
 && rm -rf /var/lib/apt/lists/*

RUN { \
        echo 'opcache.enable=1'; \
        echo 'opcache.enable_cli=1'; \
        echo 'opcache.memory_consumption=256'; \
        echo 'opcache.max_accelerated_files=30000'; \
        echo 'opcache.validate_timestamps=0'; \
    } > /usr/local/etc/php/conf.d/zz-opcache.ini

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /app
COPY . .
COPY --from=composer-deps /app/vendor vendor
COPY --from=frontend /app/public/build public/build
COPY docker/entrypoint.sh /entrypoint.sh

# composer install wyżej celowo z --no-scripts (kod aplikacji jeszcze nie
# był skopiowany na tamtym etapie) — bez tego bootstrap/cache/packages.php
# zostaje nieaktualny/pusty i providerzy pakietów (m.in. Inertii) nie są
# zarejestrowani ("Target [Inertia\Ssr\Gateway] is not instantiable", 500)
# — dokładnie ten sam, już raz udokumentowany błąd co w bin/deploy.sh.
RUN composer dump-autoload -o --no-interaction && php artisan package:discover --ansi

EXPOSE 8000 9091
ENTRYPOINT ["sh", "/entrypoint.sh"]
