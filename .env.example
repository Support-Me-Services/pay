APP_NAME="NFC Pay"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://pay.please-support-me.com
APP_LOCALE=pl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pl_PL
APP_MAINTENANCE_DRIVER=file

# --- Multi-tenant po hoście (jedna instancja obsługuje wszystkie domeny) ---
# Moduł (gateway|storefront) i baza wybierane są na podstawie hosta
# żądania — patrz config/tenants.php.
#   pay.please-support-me.com    -> gateway,            nfc_pay
#   please-support-me.com        -> storefront/church,  nfc_shop1
# TENANT to tylko fallback dla CLI / nieznanego hosta (artisan, kolejki,
# harmonogram). Np.: TENANT=please-support-me.com php artisan db:seed
TENANT=pay.please-support-me.com

# --- Baza danych ---
# Jeden user MySQL (nfc_pay) ma dostęp do obu baz:
#   nfc_pay, nfc_shop1. ResolveTenant nadpisuje DB_DATABASE per żądanie,
# więc poniższa wartość jest tylko startowa. Hasło: patrz /var/www/pay/pay/.env.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nfc_pay
DB_USERNAME=nfc_pay
DB_PASSWORD=
# Baza bramki — modele bramki (App\Modules\Gateway\Models) są przypięte do
# połączenia 'gateway' i czytają stąd, niezależnie od hosta (na hoście sklepu
# domyślny 'mysql' wskazuje nfc_shop1). Dzięki temu trasy płatności
# /pay/* mogą działać też na domenie sklepu i klient zostaje na jego domenie.
DB_GATEWAY_DATABASE=nfc_pay

# --- Bramka płatności (URL używany przez moduł sklepu do redirectów/API) ---
GATEWAY_URL=https://pay.please-support-me.com
# Klucze API sklepów do bramki — RÓŻNE per host (z tabeli shops w nfc_pay).
# Czytane przez config/tenants.php → ResolveTenant ustawia właściwy per żądanie.
GATEWAY_API_KEY_CHURCH=

# --- Operator płatności ---
PAYMENT_PROVIDER=payu
PAYU_ENV=production
PAYU_MERCHANT_ID=
PAYU_POS_ID=
PAYU_CLIENT_ID=
PAYU_CLIENT_SECRET=
PAYU_SECOND_KEY=
PAYU_NEWPOS_CLIENT_ID=
PAYU_NEWPOS_CLIENT_SECRET=

LOG_CHANNEL=stack
SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database
