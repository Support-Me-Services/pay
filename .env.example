APP_NAME="NFC Pay"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://pay.redai.pl
APP_LOCALE=pl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pl_PL
APP_MAINTENANCE_DRIVER=file

# --- Multi-tenant po hoście (jedna instancja obsługuje wszystkie domeny) ---
# Moduł (gateway|storefront), motyw (products|church) i baza wybierane są
# na podstawie hosta żądania — patrz config/tenants.php.
#   pay.redai.pl          -> gateway,    nfc_pay
#   shop2.redai.pl        -> storefront/products, nfc_shop2
#   shop1.redai.pl        -> storefront/church,   nfc_shop1
#   please-support-me.com -> storefront/church,   nfc_shop1
# TENANT to tylko fallback dla CLI / nieznanego hosta (artisan, kolejki,
# harmonogram). Np.: TENANT=shop1.redai.pl php artisan db:seed
TENANT=pay.redai.pl

# --- Baza danych ---
# Jeden user MySQL (nfc_pay) ma dostęp do WSZYSTKICH trzech baz:
#   nfc_pay, nfc_shop1, nfc_shop2. ResolveTenant nadpisuje DB_DATABASE per żądanie,
# więc poniższa wartość jest tylko startowa. Hasło: patrz /var/www/pay/pay/.env.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nfc_pay
DB_USERNAME=nfc_pay
DB_PASSWORD=

# --- Bramka płatności (URL używany przez moduł sklepu do redirectów/API) ---
GATEWAY_URL=https://pay.redai.pl
# Klucze API sklepów do bramki — RÓŻNE per host (z tabeli shops w nfc_pay).
# Czytane przez config/tenants.php → ResolveTenant ustawia właściwy per żądanie.
GATEWAY_API_KEY_CHURCH=
GATEWAY_API_KEY_PRODUCTS=

# --- Operator płatności ---
PAYMENT_PROVIDER=payu
PAYU_ENV=production
PAYU_MERCHANT_ID=
PAYU_POS_ID=
PAYU_CLIENT_ID=
PAYU_CLIENT_SECRET=
PAYU_SECOND_KEY=
PAYU_NEWPOS_CLIENT_ID=
PAYU_NEWPOS_CLIENT_SECRET=

LOG_CHANNEL=stack
SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database
